# CORS_ORIGINS lists additional frontend origins, comma-separated.
# The first-party sites (https://atlas.meteo.gov.gh and
# https://ghclimateatlas.netlify.app) are always allowed, so set this only for
# extra hosts such as a staging frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://atlas.meteo.gov.gh,https://ghclimateatlas.netlify.app

# SMTP is required for climate data request confirmation emails.
# Example Gmail host: smtp.gmail.com with SMTP_PORT=587 and SMTP_USE_TLS=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=sender@example.com
SMTP_FROM_NAME=Ghana Climate Atlas
SMTP_USE_TLS=true

# Climate Atlas updates scraped from meteo.gov.gh for the Overview page.
# Every value below is optional; these are the built-in defaults.
# GMET_NEWS_ENABLED=true
# GMET_NEWS_BASE_URL=https://www.meteo.gov.gh
# GMET_NEWS_SERVICE_ID=15
# GMET_NEWS_TTL_SECONDS=1200
# GMET_NEWS_TIMEOUT=12
# GMET_NEWS_CACHE_PATH=app/data/cache/gmet_news.json
# GMET_NEWS_BYPASS_UPSTREAM_CACHE=true
